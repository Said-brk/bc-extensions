{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/franco-fournisseur", "destination": "/franco-fournisseur.html" },
    { "source": "/franco-fournisseur/docs", "destination": "/franco-fournisseur-docs.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
